# Apple requires the app-site-association file to be served as JSON. It has no
# file extension, so most static hosts would guess application/octet-stream and
# universal links would silently fail to verify.
# Netlify / Cloudflare Pages syntax.
/.well-known/apple-app-site-association
  Content-Type: application/json

# The local dictionary. These change only when tools/build_dictionary_data.py
# is run against a new WordNet or ipa-dict, which is close to never, so a
# browser that has fetched a shard should keep it.
/dict-data/*
  Cache-Control: public, max-age=604800
